# Copy this file to .env on the NAS.

# Optional note / state file.
DASHBOARD_NOTE=FlyNAS 192.168.120.200
STATE_FILE=/data/kindle_state.json
CONFIG_FILE=/data/dashboard_config.json
MIHOMO_CONFIG_FILE=/proxy/config.yaml

# Web admin at http://NAS-IP:8787/admin. Leave blank to disable it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional manual/status text. Use these first for subscription tools.
CODEX_USAGE_TEXT=Codex: manual status pending
CLAUDE_USAGE_TEXT=Claude Code: manual status pending

# Optional horizontal quota bars shown in Chinese layout.
CODEX_3H_PERCENT=0
CODEX_3H_TEXT=短周期
CODEX_5H_PERCENT=0
CODEX_5H_TEXT=滚动窗口
CODEX_TODAY_PERCENT=0
CODEX_TODAY_TEXT=今日累计
CODEX_WEEK_PERCENT=0
CODEX_WEEK_TEXT=周累计

CLAUDE_3H_PERCENT=0
CLAUDE_3H_TEXT=短周期
CLAUDE_5H_PERCENT=0
CLAUDE_5H_TEXT=滚动窗口
CLAUDE_TODAY_PERCENT=0
CLAUDE_TODAY_TEXT=今日累计
CLAUDE_WEEK_PERCENT=0
CLAUDE_WEEK_TEXT=周累计

# Optional crypto line chart window. 1 means roughly the last 24 hours.
COINGECKO_CHART_DAYS=1

# Optional manual Kindle battery override. Prefer /update?kindle_battery=87 from Kindle.
# KINDLE_BATTERY_TEXT=87%

# Real organization API usage. Use Admin keys, not ordinary model-call keys.
# Keep these secrets only on the NAS and never commit/share the .env file.
OPENAI_ADMIN_KEY=
ANTHROPIC_ADMIN_KEY=

# Optional token budgets used only to calculate bar percentages.
# Without budgets, the dashboard still shows real token totals and marks the bars as "实时".
# OPENAI_3H_TOKEN_BUDGET=1000000
# OPENAI_5H_TOKEN_BUDGET=2000000
# OPENAI_TODAY_TOKEN_BUDGET=5000000
# OPENAI_WEEK_TOKEN_BUDGET=30000000
# ANTHROPIC_3H_TOKEN_BUDGET=1000000
# ANTHROPIC_5H_TOKEN_BUDGET=2000000
# ANTHROPIC_TODAY_TOKEN_BUDGET=5000000
# ANTHROPIC_WEEK_TOKEN_BUDGET=30000000

# Live quota files. The files are reread on each dashboard refresh; no restart is needed.
CODEX_USAGE_FILE=/data/codex_usage.json
CLAUDE_USAGE_FILE=/data/claude_usage.json

# Published host bindings; set NAS_BIND_IP to the NAS LAN address.
NAS_BIND_IP=192.168.120.200
NAS_LAN_HOST=192.168.120.200
WHATSAPP_BIND_IP=0.0.0.0
WHATSAPP_IPV6_BIND_IP=[::]
